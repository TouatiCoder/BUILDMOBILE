# Public client configuration only. EXPO_PUBLIC_* values are embedded in the
# app bundle: NEVER put database URLs, JWT secrets, API keys or passwords here.
#
# Resend is configured on the BuildStock backend only:
# RESEND_API_KEY, RESEND_DOMAIN, RESEND_FROM_EMAIL,
# RESEND_FROM_INVITATIONS and RESEND_FROM_ADMIN belong in the backend's
# server environment, not in this mobile project.
#
# Base URL of the existing BuildStock Next.js backend (no trailing slash).
# - Android emulator  -> http://10.0.2.2:3000
# - iOS simulator     -> http://localhost:3000
# - Physical phone    -> http://<your PC's LAN IP>:3000  (same Wi-Fi)
# - Production        -> your deployed BuildStock backend URL
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Optional: website URL used for "open on the website" links (defaults to the API URL).
# Password-reset emails sent through Resend open the website's reset-password page.
EXPO_PUBLIC_WEB_URL=
