# Public client configuration only. EXPO_PUBLIC_* values are embedded in the
# app bundle: NEVER put database URLs, JWT secrets, API keys or passwords here.

# Base URL of the existing BuildStock Next.js backend (no trailing slash).
# - Android emulator  -> http://10.0.2.2:3000
# - iOS simulator     -> http://localhost:3000
# - Physical phone    -> http://<your PC's LAN IP>:3000  (same Wi-Fi; see docs/MOBILE_ARCHITECTURE.md)
# - Production        -> https://your-domain.example
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Optional: website URL used for "open on the website" links (defaults to the API URL).
EXPO_PUBLIC_WEB_URL=
