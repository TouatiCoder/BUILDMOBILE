  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/calculators && tsc --noEmit -p tests/unit",
    "test:unit": "jest",
    "test:calculators": "tsx --test tests/calculators/concrete.test.ts tests/calculators/formwork.test.ts tests/calculators/mesh.test.ts tests/calculators/steel.test.ts",
    "test": "npm run test:unit && npm run test:calculators",
    "test:api": "node tests/api/smoke.mjs",
    "test:isolation": "node tests/api/isolation.mjs",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/tests/unit/setup.ts"
    ]
  }
